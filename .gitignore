# ==========================================
# Quádralo - Root .gitignore
# ==========================================

# ------------------------------------------
# Dependencies
# ------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.js

# ------------------------------------------
# Python & FastAPI Backend
# ------------------------------------------
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------
# Local Databases (SQLite)
# ------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
adatov.db
backend/adatov.db
quadralo.db
backend/quadralo.db

# ------------------------------------------
# Next.js & Frontend Build Outputs
# ------------------------------------------
.next/
*/.next/
out/
build/
dist/
.vercel/

# ------------------------------------------
# TypeScript & Testing
# ------------------------------------------
*.tsbuildinfo
coverage/
.nyc_output/

# ------------------------------------------
# Environment & Secrets (Keep .env.example)
# ------------------------------------------
.env
.env*.local
.env.development
.env.test
.env.production
backend/.env
backend/.env*.local
*.pem
*.key
*.cert

# ------------------------------------------
# Logs & Debug
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# OS & Editor Specific Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
